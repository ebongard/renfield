# Dockerignore for the backend image. The build context is src/backend/ (not
# the repo root — see .claude/skills/deploy-production/SKILL.md).
#
# The three YAML files below are provided by the `renfield-mcp-config`
# ConfigMap at runtime via subPath mounts. They must NOT ship in the image:
# kubelet subPath-mounting a file over a file works; over a directory or
# missing path it fails with "not a directory". If a stray file or
# directory with these names ends up in the build context (e.g. from
# kubelet artifacts on the build box, or a local copy someone left
# behind), the build would silently bake it in and every pod restart
# after the next deploy would crashloop on the mount.
config/mcp_servers.yaml
config/agent_roles.yaml
config/kg_scopes.yaml
config/mail_accounts.yaml
config/mail_accounts.default.yaml

# Python bytecode caches, test artefacts, editor scratch.
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Test suite + test-only files must NEVER ship in the runtime image. The real
# suite lives at repo-root tests/ — outside this build context — so a clean
# staging build already excludes it. These patterns are defense-in-depth: if a
# build ever runs from a polluted context (e.g. the /opt/renfield compose
# checkout, which bind-mounts source and where stray test copies accumulate)
# they still can't be baked in. No git-tracked runtime module matches these
# names, so nothing legitimate is dropped. requirements-test.txt is the dev/test
# deps manifest (used only by the .159 compose stack); the Dockerfile installs
# requirements.txt only, so it must not leak into the image either.
tests
conftest.py
test_*.py
pytest.ini
requirements-test.txt

# Virtualenvs shouldn't leak into the image.
.venv
venv

# The satellite source is synced into the build context as satellite/ and COPY'd
# into the image for the OTA update package (build_update_package only needs
# renfield_satellite/ + requirements.txt + setup.py). Keep the gitignored ansible
# inventory (real household IPs/hostnames) and the satellite test suite OUT of the
# image regardless of what the rsync left in the context.
satellite/provisioning
satellite/tests
vendor/mcp-server-searxng/node_modules/
