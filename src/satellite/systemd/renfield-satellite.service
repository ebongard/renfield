[Unit]
Description=Renfield Satellite Voice Assistant
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=audio
WorkingDirectory=/opt/renfield-satellite
ExecStart=/opt/renfield-satellite/venv/bin/python -m renfield_satellite config/satellite.yaml
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Allow access to hardware
SupplementaryGroups=spi gpio i2c

# Resource limits: the same value the Ansible unit renders for a Pi Zero 2 W
# (provisioning/group_vars satellite_memory_max; an Orange Pi gets 1G there).
MemoryMax=450M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=renfield-satellite

[Install]
WantedBy=multi-user.target
