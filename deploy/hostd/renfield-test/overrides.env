# What makes the production config (base.env, rendered from k8s/configmap.yaml) the TEST
# instance on Host D. Rule: nothing here may reach a production system or a real
# person — every integration that writes, notifies or controls something real is off.
# No secrets in this file (those live in secrets.env on the box).

# --- identity: an own instance, never mistaken for the household ---------------------
INSTANCE_ID=test
FEDERATION_INSTANCE_NAME=Test
FEDERATION_ADVERTISED_URL=https://renfield-test.local
FEDERATION_REQUIRE_PERSISTENT_IDENTITY=false
FEDERATION_REACHABILITY_ENABLED=false
FEDERATION_IDENTITY_LINKS_ENABLED=false
CORS_ORIGINS=https://renfield-test.local
ADVERTISE_HOST=renfield-test.local
ADVERTISE_SCHEME=https
ADVERTISE_PORT=443
# Nobody watches the household from here (and the household does not watch the test box).
WATCHDOG_TARGETS=

# --- GPU tier: LXC 100 gpu-ct next door (deploy/hostd/*.service) ----------------------
LLM_OPENAI_BASE_URL=http://192.168.1.137:8081/v1
OLLAMA_VISION_URL=http://192.168.1.137:8081/v1
OLLAMA_URL=http://192.168.1.137:11434
OLLAMA_EMBED_URL=http://192.168.1.137:11434
LLM_OPENAI_EMBED_BASE_URL=http://192.168.1.137:11434/v1
AGENT_ROUTER_URL=http://192.168.1.137:11434
VOICE_SERVER_URL=http://192.168.1.137:8091

# --- own services in this compose project ---------------------------------------------
SEARXNG_API_URL=http://searxng:8080
SEARXNG_INSTANCES=http://searxng:8080
PAPERLESS_API_URL=http://paperless:8000
PAPERLESS_PUBLIC_URL=http://renfield-test.local:8000

# --- OFF: real household systems -------------------------------------------------------
FEATURE_SMART_HOME=false
FEATURE_CAMERAS=false
HA_MCP_ENABLED=false
N8N_MCP_ENABLED=false
JELLYFIN_ENABLED=false
DLNA_MCP_ENABLED=false
SAMSUNG_MCP_ENABLED=false
SCANNER_MCP_ENABLED=false
EMAIL_MCP_ENABLED=false
EMAIL_INGEST_ENABLED=false
FILES_MCP_ENABLED=false
FOLDER_INGEST_ENABLED=false
FOLDER_INGEST_RENAME_PROCESSED_ENABLED=false
MEDIA_FOLLOW_ENABLED=false
OUTPUT_PROVIDERS_ENABLED=false

# --- OFF: anything that reaches a person or a device ----------------------------------
PUSH_NOTIFICATIONS_ENABLED=false
OBLIGATION_NOTIFIER_ENABLED=false
OBLIGATION_DIGEST_ENABLED=false
PROACTIVE_ENABLED=false
PRESENCE_ENABLED=false
BT_SCAN_ENABLED=false
SATELLITE_ENROLLMENT_ENABLED=false
SATELLITE_ENROLLMENT_AUTOFLIP_ENABLED=false
ROOM_HANDOFF_ENABLED=false
