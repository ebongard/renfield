voice-server/tests/b5/corpus_production.txt

# Schicht A golden set — REAL household docs + labels, NEVER commit (privacy)
tests/eval/schicht_a_fixtures_local/

# Custom wakeword models are fetched into the build context, not committed
src/satellite/models/

# Command-center design assets — ~41MB of screenshots/video for the DECOMMISSIONED
# admin board (docs/design/command-center.md is SUPERSEDED). Kept locally, never
# committed (permanent repo bloat).
docs/design/assets/

# Flash-erase scratch image (4MB of 0xFF) — regenerable, never commit.
src/satellite/hardware/xvf3800/firmware/*_all_ff.bin

# Marketing website — moved out of the public product repo (business/legal content).
site/

# Real prod-guard substrings for memory_v1_baseline (real infra names) — NEVER public.
bin/prod_url_patterns.private
